    {
      "name": "Utilisateurs (ADMIN only)",
      "item": [
        {
          "name": "Get all utilisateurs",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Astuce: récupère un medecinId automatiquement si trouvé",
                  "try {",
                  "  const users = pm.response.json();",
                  "  if (Array.isArray(users)) {",
                  "    const med = users.find(u => u && u.role === 'MEDECIN');",
                  "    if (med && med.id) pm.environment.set('medecinId', String(med.id));",
                  "  }",
                  "} catch (e) {}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/utilisateurs"
          }
        },
        {
          "name": "Get utilisateur by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/utilisateurs/{{utilisateurId}}"
          }
        },
        {
          "name": "Create utilisateur (wrapper request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.id) pm.environment.set('utilisateurId', String(json.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"utilisateur\": {\n    \"actif\": true,\n    \"role\": \"SECRETAIRE\",\n    \"nom\": \"Test\",\n    \"prenom\": \"Secretaire\",\n    \"numTel\": \"0600000000\",\n    \"cabinetId\": {{cabinetId}}\n  },\n  \"auth\": {\n    \"login\": \"test.secretaire\",\n    \"password\": \"Secretaire123\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/utilisateurs"
          }
        },
        {
          "name": "Update utilisateur",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actif\": true,\n  \"nom\": \"Test\",\n  \"prenom\": \"Updated\",\n  \"numTel\": \"0600000001\"\n}"
